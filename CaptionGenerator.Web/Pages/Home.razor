@page "/"
@inject AuthStateStore AuthStateStore
@inject AuthApiClient AuthApiClient

<PageTitle>Home</PageTitle>

<section class="home-page">
    <div class="home-page-content">
        @if (!_ready)
        {
            <p class="home-status">Loading session...</p>
        }
        else if (!AuthStateStore.IsAuthenticated)
        {
            <div class="home-hero">
                <div class="home-copy">
                    <p class="home-eyebrow">Caption workflow, simplified</p>
                    <h1 class="home-title">
                        Generate captions, schedule posts, and keep track of publishing in one clean space.
                        <a class="home-inline-cta" href="/register">Try caption generator</a>
                    </h1>
                    <p class="home-subtitle">
                        Keep your content organized from upload to publish decision, with a lighter, faster interface.
                    </p>

                    <div class="home-highlights">
                        <span>AI captions</span>
                        <span>Scheduled publishing</span>
                        <span>Confirm / cancel flow</span>
                    </div>
                </div>

                <div class="home-visual">
                    <div class="home-visual-panel">
                        <p class="home-visual-label">What you get</p>
                        <ul class="home-visual-list">
                            <li>Upload an image and generate a caption automatically</li>
                            <li>Schedule the post for later without losing context</li>
                            <li>Decide publish or cancel once the scheduled time arrives</li>
                        </ul>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="home-hero">
                <div class="home-copy">
                    <p class="home-eyebrow">Welcome back</p>
                    <h1 class="home-title">Your posting workspace is ready.</h1>
                    <p class="home-subtitle">
                        Open the dashboard and manage your posts with a cleaner workflow.
                    </p>

                    <div class="home-authenticated-actions">
                        <a class="btn btn-primary btn-lg" href="/dashboard">Open dashboard</a>
                        <a class="btn btn-outline-primary btn-lg" href="/posts">Manage posts</a>
                    </div>
                </div>

                <div class="home-visual">
                    <div class="home-visual-panel">
                        <p class="home-visual-label">Today</p>
                        <ul class="home-visual-list">
                            <li>Review published and pending posts from the dashboard</li>
                            <li>Handle scheduled items with Yes / No confirmation</li>
                            <li>Keep your social content pipeline tidy and fast</li>
                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        await AuthStateStore.InitializeAsync();
        await AuthApiClient.ApplyAuthHeaderAsync();
        _ready = true;
    }
}
