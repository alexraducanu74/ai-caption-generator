@page "/"
@inject AuthStateStore AuthStateStore
@inject AuthApiClient AuthApiClient
@inject NavigationManager NavigationManager

<PageTitle>Home</PageTitle>

<section class="home-page">
    <div class="home-page-content">
        @if (!_ready)
        {
            <div class="surface-card home-surface-card">
                <div class="card-body">Loading session...</div>
            </div>
        }
        else if (!AuthStateStore.IsAuthenticated)
        {
            <div class="surface-card home-surface-card">
                <div class="card-body home-auth-card">
                    <p class="mb-3 home-auth-title">Generate captions quickly and manage all your posts in one place.</p>
                    <p class="text-muted mb-4 home-auth-subtitle">Create an account or sign in to start generating and managing posts.</p>
                    <div class="home-auth-actions">
                        <a class="btn btn-primary" href="/login">Login</a>
                        <a class="btn btn-outline-secondary" href="/register">Register</a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="surface-card home-surface-card">
                <div class="card-body home-auth-card">
                    <div class="home-authenticated-actions">
                        <a class="btn btn-primary" href="/dashboard">Open dashboard</a>
                        <a class="btn btn-outline-primary" href="/posts">Manage posts</a>
                        <button class="btn btn-outline-danger" @onclick="LogoutAsync">Logout</button>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        await AuthStateStore.InitializeAsync();
        await AuthApiClient.ApplyAuthHeaderAsync();
        _ready = true;
    }

    private async Task LogoutAsync()
    {
        await AuthApiClient.LogoutAsync();
        NavigationManager.NavigateTo("/login", true);
    }
}
