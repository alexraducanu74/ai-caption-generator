@page "/posts"
@implements IDisposable
@inject AuthStateStore AuthStateStore
@inject AuthApiClient AuthApiClient
@inject PostsApiClient PostsApiClient
@inject IJSRuntime Js

<PageTitle>Posts</PageTitle>

<div class="page-header">
    <h1 class="page-title">Posts</h1>
    <p class="page-subtitle">Create, update, and delete social posts with generated captions.</p>
</div>

@if (!_ready)
{
    <div class="surface-card">
        <div class="card-body">Loading posts...</div>
    </div>
}
else if (!AuthStateStore.IsAuthenticated)
{
    <div class="surface-card">
        <div class="card-body">
            <div class="alert alert-warning mb-3" role="alert">
                You must log in to upload images and create posts.
            </div>
            <a class="btn btn-primary" href="/login">Go to login</a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-5">
            <div class="surface-card post-compose-card">
                <div class="card-body post-compose-body">
                    <div class="post-compose-header">
                        <div>
                            <p class="post-compose-kicker">New post</p>
                            <h5 class="card-title mb-1">Create and schedule</h5>
                            <p class="post-compose-subtitle mb-0">Upload an image, choose a platform, and pick a future publish time.</p>
                        </div>
                        <div class="post-compose-badge">AI captioning</div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_message))
                    {
                        <div class="alert @(_isError ? "alert-danger" : "alert-success")" role="alert">@_message</div>
                    }

                    <EditForm Model="_form" OnValidSubmit="CreatePostAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3 post-field">
                            <label class="form-label">Platform</label>
                            <InputSelect class="form-select" @bind-Value="_form.Platform">
                                <option value="0">Facebook</option>
                                <option value="1">Instagram</option>
                            </InputSelect>
                        </div>

                        <div class="mb-3 post-schedule-panel">
                            <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap mb-3">
                                <div>
                                    <label class="form-label mb-1">Publish schedule</label>
                                    <div class="post-schedule-meta">Choose a date and time, or use a quick preset.</div>
                                </div>
                                <span class="post-schedule-pill">@_form.ScheduledForLocal.ToString("ddd, MMM d • HH:mm")</span>
                            </div>

                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label small text-muted mb-1">Date</label>
                                    <InputDate class="form-control form-control-lg post-schedule-input" Type="InputDateType.Date" @bind-Value="_form.ScheduledDate" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label small text-muted mb-1">Time</label>
                                    <div class="post-time-picker">
                                        <button type="button" class="btn btn-outline-primary post-time-trigger" @onclick="ToggleTimePicker">
                                            @_form.ScheduledHour.ToString("00"):@_form.ScheduledMinute.ToString("00")
                                        </button>

                                        @if (_showTimePicker)
                                        {
                                            <div class="post-time-popover" role="dialog" aria-label="Pick time">
                                                <div class="post-time-selectors">
                                                    <div class="post-time-column">
                                                        <span class="post-time-column-label">Hour (24h)</span>
                                                        <div class="post-time-scroll" role="listbox" aria-label="Hours">
                                                            @foreach (var hour in HourOptions)
                                                            {
                                                                <button type="button" class="post-time-option @(hour == _form.ScheduledHour ? "active" : null)" @onclick="() => SetScheduledHour(hour)">@hour.ToString("00")</button>
                                                            }
                                                        </div>
                                                    </div>
                                                    <div class="post-time-column">
                                                        <span class="post-time-column-label">Minute</span>
                                                        <div class="post-time-scroll" role="listbox" aria-label="Minutes">
                                                            @foreach (var minute in MinuteOptions)
                                                            {
                                                                <button type="button" class="post-time-option @(minute == _form.ScheduledMinute ? "active" : null)" @onclick="() => SetScheduledMinute(minute)">@minute.ToString("00")</button>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="post-time-actions">
                                                    <button type="button" class="btn btn-sm btn-primary" @onclick="CloseTimePicker">Done</button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="post-schedule-presets">
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => SetSchedule(DateTime.Now.AddHours(1))">In 1 hour</button>
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="SetTomorrowMorning">Tomorrow 9:00</button>
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="SetTomorrowEvening">Tomorrow 18:00</button>
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="SetNextWeekdayMorning">Next weekday 9:00</button>
                            </div>
                        </div>

                        <div class="mb-3 post-field">
                            <label class="form-label">Image</label>
                            <div class="post-upload-panel">
                                <InputFile class="post-upload-input" OnChange="OnImageSelected" accept=".jpg,.jpeg,.png,.webp" />
                                @if (_selectedImage is not null)
                                {
                                    <div class="post-upload-selected">
                                        <span class="post-upload-selected-label">Selected image</span>
                                        <strong>@_selectedImage.Name</strong>
                                    </div>
                                }
                                else
                                {
                                    <div class="post-upload-empty">Choose a JPG, PNG, or WEBP file to generate and schedule a caption post.</div>
                                }
                            </div>
                        </div>

                        <button class="btn btn-primary btn-lg post-submit-btn" type="submit" disabled="@_submitting">@(_submitting ? "Creating..." : "Upload + Create")</button>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="surface-card post-feed-card">
                <div class="card-body post-feed-body">
                    <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
                        <h5 class="card-title mb-0">Recent posts</h5>
                        <div class="d-flex align-items-center gap-2">
                            <label class="small text-muted mb-0" for="createdAtSort">Sort by time</label>
                            <InputSelect id="createdAtSort" class="form-select form-select-sm" style="width: 170px;" @bind-Value="_createdAtSortOrder">
                                <option value="@CreatedAtSortOrder.Descending">Newest first</option>
                                <option value="@CreatedAtSortOrder.Ascending">Oldest first</option>
                            </InputSelect>
                        </div>
                    </div>

                    @if (_posts.Count == 0)
                    {
                        <p class="text-muted mb-0">No posts yet.</p>
                    }
                    else
                    {
                        @foreach (var post in SortedPosts)
                        {
                            var isEditing = _editingPostId == post.Id;
                            var isBusy = _busyPostIds.Contains(post.Id);

                            <div class="post-item">
                                <div class="post-item-header">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <strong class="post-item-platform">@post.Platform</strong>
                                        <span class="badge @StatusBadgeClass(post.Status) post-item-status">@post.Status</span>
                                    </div>
                                    <small class="post-item-timestamp">@post.CreatedAtUtc.ToLocalTime()</small>
                                </div>

                                @if (isEditing)
                                {
                                    <div class="post-edit-panel">
                                        <div class="mb-3">
                                            <label class="form-label mb-1">Caption</label>
                                            <InputTextArea class="form-control post-caption-input" @bind-Value="_editForm.Caption" rows="3" />
                                            <small class="text-muted">@_editForm.Caption.Length / 280</small>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label mb-1">Replace image (optional)</label>
                                            <InputFile class="post-upload-input" OnChange="OnEditImageSelected" accept=".jpg,.jpeg,.png,.webp" />
                                            @if (_editSelectedImage is not null)
                                            {
                                                <small class="d-block text-muted mt-1">Selected: @_editSelectedImage.Name</small>
                                            }
                                        </div>
                                    </div>

                                    <div class="d-flex flex-wrap gap-2">
                                        <button class="btn btn-sm btn-primary" disabled="@isBusy" @onclick="() => SaveEditAsync(post)">
                                            @(isBusy ? "Saving..." : "Save")
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary" disabled="@isBusy" @onclick="CancelEdit">
                                            Cancel
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="post-item-body">
                                        <p class="post-caption mb-1">@post.Caption</p>
                                        <div class="post-schedule-copy">Scheduled for <strong>@post.ScheduledForUtc.ToLocalTime()</strong></div>
                                        <img src="@post.ImageUrl" alt="post image" class="post-item-image img-fluid mb-2" />
                                    </div>

                                    @if (post.Status == "PendingConfirmation")
                                    {
                                        <div class="post-publish-section">
                                            <div class="alert alert-warning py-2 mb-0" role="alert">
                                                <strong>Published?</strong> This post reached its scheduled time.
                                                <div class="post-publish-actions d-flex flex-wrap gap-2 mt-2">
                                                    <button class="btn btn-sm btn-success" disabled="@isBusy" @onclick="() => ConfirmPostAsync(post)">
                                                        Yes
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger" disabled="@isBusy" @onclick="() => CancelPostAsync(post)">
                                                        No
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <div class="post-manage-section d-flex flex-wrap gap-2">
                                        <button class="btn btn-sm btn-outline-primary" disabled="@isBusy" @onclick="() => StartEdit(post)">
                                            Edit
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" disabled="@isBusy" @onclick="() => DeletePostAsync(post)">
                                            @(isBusy ? "Deleting..." : "Delete")
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly CreatePostForm _form = new();
    private readonly EditPostForm _editForm = new();
    private readonly List<PostResponse> _posts = [];
    private readonly HashSet<Guid> _busyPostIds = [];
    private static readonly int[] HourOptions = Enumerable.Range(0, 24).ToArray();
    private static readonly int[] MinuteOptions = Enumerable.Range(0, 12).Select(i => i * 5).ToArray();
    private IBrowserFile? _selectedImage;
    private IBrowserFile? _editSelectedImage;
    private Guid? _editingPostId;
    private bool _ready;
    private bool _submitting;
    private bool _showTimePicker;
    private bool _isError;
    private string? _message;
    private CreatedAtSortOrder _createdAtSortOrder = CreatedAtSortOrder.Descending;
    private CancellationTokenSource? _refreshCts;

    private IEnumerable<PostResponse> SortedPosts => _createdAtSortOrder == CreatedAtSortOrder.Ascending
        ? _posts.OrderBy(p => p.CreatedAtUtc)
        : _posts.OrderByDescending(p => p.CreatedAtUtc);

    protected override async Task OnInitializedAsync()
    {
        await AuthStateStore.InitializeAsync();
        _ready = true;

        if (!AuthStateStore.IsAuthenticated)
        {
            return;
        }

        await LoadPostsAsync();
        StartAutoRefresh();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && AuthStateStore.IsAuthenticated)
        {
            await AuthApiClient.ApplyAuthHeaderAsync();
            StateHasChanged();
        }
    }

    private async Task LoadPostsAsync()
    {
        var posts = await PostsApiClient.GetPostsAsync();
        _posts.Clear();
        _posts.AddRange(posts);
    }

    private void StartAutoRefresh()
    {
        _refreshCts?.Cancel();
        _refreshCts = new CancellationTokenSource();
        _ = RefreshLoopAsync(_refreshCts.Token);
    }

    private async Task RefreshLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (!AuthStateStore.IsAuthenticated)
                {
                    continue;
                }

                await InvokeAsync(LoadPostsAsync);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void OnImageSelected(InputFileChangeEventArgs args)
    {
        _selectedImage = args.File;
    }

    private void OnEditImageSelected(InputFileChangeEventArgs args)
    {
        _editSelectedImage = args.File;
    }

    private void StartEdit(PostResponse post)
    {
        _editingPostId = post.Id;
        _editSelectedImage = null;
        _editForm.Caption = post.Caption;
    }

    private void CancelEdit()
    {
        _editingPostId = null;
        _editSelectedImage = null;
        _editForm.Caption = string.Empty;
    }

    private async Task SaveEditAsync(PostResponse post)
    {
        _message = null;
        _isError = false;

        if (string.IsNullOrWhiteSpace(_editForm.Caption))
        {
            _isError = true;
            _message = "Caption is required.";
            return;
        }

        if (_editForm.Caption.Length > 280)
        {
            _isError = true;
            _message = "Caption must be at most 280 characters.";
            return;
        }

        _busyPostIds.Add(post.Id);

        try
        {
            var imageUrl = post.ImageUrl;

            if (_editSelectedImage is not null)
            {
                var uploadResult = await PostsApiClient.UploadImageAsync(_editSelectedImage);
                if (!uploadResult.Success || string.IsNullOrWhiteSpace(uploadResult.ImageUrl))
                {
                    _isError = true;
                    _message = uploadResult.Message;
                    return;
                }

                imageUrl = uploadResult.ImageUrl;
            }

            var updateResult = await PostsApiClient.UpdatePostAsync(post.Id, new UpdatePostRequest(_editForm.Caption.Trim(), imageUrl));
            _isError = !updateResult.Success;
            _message = updateResult.Message;

            if (updateResult.Success)
            {
                CancelEdit();
                await LoadPostsAsync();
            }
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _busyPostIds.Remove(post.Id);
        }
    }

    private async Task DeletePostAsync(PostResponse post)
    {
        var confirmed = await Js.InvokeAsync<bool>("confirm", "Delete this post?");
        if (!confirmed)
        {
            return;
        }

        _message = null;
        _isError = false;
        _busyPostIds.Add(post.Id);

        try
        {
            var deleteResult = await PostsApiClient.DeletePostAsync(post.Id);
            _isError = !deleteResult.Success;
            _message = deleteResult.Message;

            if (deleteResult.Success)
            {
                if (_editingPostId == post.Id)
                {
                    CancelEdit();
                }

                await LoadPostsAsync();
            }
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _busyPostIds.Remove(post.Id);
        }
    }

    private async Task ConfirmPostAsync(PostResponse post)
    {
        await HandleStatusDecisionAsync(post, () => PostsApiClient.ConfirmPostAsync(post.Id));
    }

    private async Task CancelPostAsync(PostResponse post)
    {
        await HandleStatusDecisionAsync(post, () => PostsApiClient.CancelPostAsync(post.Id));
    }

    private async Task HandleStatusDecisionAsync(PostResponse post, Func<Task<(bool Success, string Message)>> action)
    {
        _message = null;
        _isError = false;
        _busyPostIds.Add(post.Id);

        try
        {
            var result = await action();
            _isError = !result.Success;
            _message = result.Message;

            if (result.Success)
            {
                await LoadPostsAsync();
            }
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _busyPostIds.Remove(post.Id);
        }
    }

    private async Task CreatePostAsync()
    {
        _message = null;
        _isError = false;

        if (_selectedImage is null)
        {
            _isError = true;
            _message = "Please select an image before creating the post.";
            return;
        }

        var scheduledForUtc = DateTime.SpecifyKind(_form.ScheduledForLocal, DateTimeKind.Local).ToUniversalTime();
        if (scheduledForUtc <= DateTime.UtcNow)
        {
            _isError = true;
            _message = "Scheduled publish date must be in the future.";
            return;
        }

        _submitting = true;

        try
        {
            var uploadResult = await PostsApiClient.UploadImageAsync(_selectedImage);
            if (!uploadResult.Success || string.IsNullOrWhiteSpace(uploadResult.ImageUrl))
            {
                _isError = true;
                _message = uploadResult.Message;
                return;
            }

            var createResult = await PostsApiClient.CreatePostAsync(new CreatePostRequest(_form.Platform, uploadResult.ImageUrl, scheduledForUtc));

            _isError = !createResult.Success;
            _message = createResult.Message;

            if (createResult.Success)
            {
                _form.Platform = 0;
                _form.ResetSchedule(DateTime.Now.AddMinutes(10));
                _selectedImage = null;
                await LoadPostsAsync();
            }
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }

    private sealed class CreatePostForm
    {
        [Range(0, 1)]
        public int Platform { get; set; }

        [Required]
        public DateOnly ScheduledDate { get; set; } = DateOnly.FromDateTime(DateTime.Now.AddMinutes(10));

        [Required]
        [Range(0, 23)]
        public int ScheduledHour { get; set; } = DateTime.Now.AddMinutes(10).Hour;

        [Required]
        [Range(0, 55)]
        public int ScheduledMinute { get; set; } = RoundMinuteToFive(DateTime.Now.AddMinutes(10).Minute);

        public DateTime ScheduledForLocal => ScheduledDate.ToDateTime(new TimeOnly(ScheduledHour, ScheduledMinute), DateTimeKind.Local);

        public void ResetSchedule(DateTime localDateTime)
        {
            var value = localDateTime.Kind == DateTimeKind.Unspecified
                ? DateTime.SpecifyKind(localDateTime, DateTimeKind.Local)
                : localDateTime.ToLocalTime();

            ScheduledDate = DateOnly.FromDateTime(value);
            ScheduledHour = value.Hour;
            ScheduledMinute = RoundMinuteToFive(value.Minute);
        }

        private static int RoundMinuteToFive(int minute)
        {
            var rounded = (int)Math.Round(minute / 5.0) * 5;
            return rounded >= 60 ? 55 : rounded;
        }
    }

    private sealed class EditPostForm
    {
        [Required]
        [MaxLength(280)]
        public string Caption { get; set; } = string.Empty;
    }

    private enum CreatedAtSortOrder
    {
        Descending,
        Ascending
    }

    private static string StatusBadgeClass(string status) => status switch
    {
        "Published" => "text-bg-success",
        "PendingConfirmation" => "text-bg-warning",
        "Canceled" => "text-bg-danger",
        "Scheduled" => "text-bg-secondary",
        _ => "text-bg-light"
    };

    public void Dispose()
    {
        _refreshCts?.Cancel();
        _refreshCts?.Dispose();
    }

    private void SetTomorrowMorning() => SetSchedule(DateTime.Now.Date.AddDays(1).AddHours(9));

    private void SetTomorrowEvening() => SetSchedule(DateTime.Now.Date.AddDays(1).AddHours(18));

    private void ToggleTimePicker() => _showTimePicker = !_showTimePicker;

    private void CloseTimePicker() => _showTimePicker = false;

    private void SetScheduledHour(int hour) => _form.ScheduledHour = hour;

    private void SetScheduledMinute(int minute) => _form.ScheduledMinute = minute;

    private void SetNextWeekdayMorning()
    {
        var day = DateTime.Now.Date.AddDays(1);

        while (day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)
        {
            day = day.AddDays(1);
        }

        SetSchedule(day.AddHours(9));
    }

    private void SetSchedule(DateTime value)
    {
        _form.ResetSchedule(value);
        _showTimePicker = false;
    }
}
