@page "/posts"
@inject AuthStateStore AuthStateStore
@inject PostsApiClient PostsApiClient
@inject IJSRuntime JS

<PageTitle>Posts</PageTitle>

@if (!_ready)
{
    <p>Loading...</p>
}
else if (!AuthStateStore.IsAuthenticated)
{
    <div class="alert alert-warning" role="alert">
        You must log in to upload images and create posts.
    </div>
    <a class="btn btn-primary" href="/login">Go to login</a>
}
else
{
    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Create post</h5>
                    <p class="text-muted small">Caption is generated automatically by the backend Python API.</p>

                    @if (!string.IsNullOrWhiteSpace(_message))
                    {
                        <div class="alert @(_isError ? "alert-danger" : "alert-success")" role="alert">@_message</div>
                    }

                    <EditForm Model="_form" OnValidSubmit="CreatePostAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Platform</label>
                            <InputSelect class="form-select" @bind-Value="_form.Platform">
                                <option value="0">Facebook</option>
                                <option value="1">Instagram</option>
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Image</label>
                            <InputFile OnChange="OnImageSelected" accept=".jpg,.jpeg,.png,.webp" />
                            @if (_selectedImage is not null)
                            {
                                <small class="d-block text-muted mt-1">Selected: @_selectedImage.Name</small>
                            }
                        </div>

                        <button class="btn btn-primary" type="submit" disabled="@_submitting">@(_submitting ? "Creating..." : "Upload + Create")</button>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title mb-0">Recent posts</h5>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadPostsAsync">Refresh</button>
                    </div>

                    @if (_posts.Count == 0)
                    {
                        <p class="text-muted mb-0">No posts yet.</p>
                    }
                    else
                    {
                        @foreach (var post in _posts.OrderByDescending(p => p.CreatedAtUtc))
                        {
                            var isEditing = _editingPostId == post.Id;
                            var isBusy = _busyPostIds.Contains(post.Id);

                            <div class="border rounded p-3 mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <strong>@post.Platform</strong>
                                        <span class="badge text-bg-light">@post.Status</span>
                                    </div>
                                    <small class="text-muted">@post.CreatedAtUtc.ToLocalTime()</small>
                                </div>

                                @if (isEditing)
                                {
                                    <div class="mb-2">
                                        <label class="form-label mb-1">Caption</label>
                                        <InputTextArea class="form-control" @bind-Value="_editForm.Caption" rows="2" />
                                        <small class="text-muted">@_editForm.Caption.Length / 280</small>
                                    </div>

                                    <div class="mb-2">
                                        <label class="form-label mb-1">Replace image (optional)</label>
                                        <InputFile OnChange="OnEditImageSelected" accept=".jpg,.jpeg,.png,.webp" />
                                        @if (_editSelectedImage is not null)
                                        {
                                            <small class="d-block text-muted mt-1">Selected: @_editSelectedImage.Name</small>
                                        }
                                    </div>

                                    <div class="d-flex flex-wrap gap-2">
                                        <button class="btn btn-sm btn-primary" disabled="@isBusy" @onclick="() => SaveEditAsync(post)">
                                            @(isBusy ? "Saving..." : "Save")
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary" disabled="@isBusy" @onclick="CancelEdit">
                                            Cancel
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <p class="mb-2">@post.Caption</p>
                                    <img src="@post.ImageUrl" alt="post image" class="img-fluid rounded mb-2" style="max-height: 180px;" />

                                    <div class="d-flex flex-wrap gap-2">
                                        <button class="btn btn-sm btn-outline-primary" disabled="@isBusy" @onclick="() => StartEdit(post)">
                                            Edit
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" disabled="@isBusy" @onclick="() => DeletePostAsync(post)">
                                            @(isBusy ? "Deleting..." : "Delete")
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly CreatePostForm _form = new();
    private readonly EditPostForm _editForm = new();
    private readonly List<PostResponse> _posts = [];
    private readonly HashSet<Guid> _busyPostIds = [];
    private IBrowserFile? _selectedImage;
    private IBrowserFile? _editSelectedImage;
    private Guid? _editingPostId;
    private bool _ready;
    private bool _submitting;
    private bool _isError;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        await AuthStateStore.InitializeAsync();

        if (!AuthStateStore.IsAuthenticated)
        {
            _ready = true;
            return;
        }

        await LoadPostsAsync();
        _ready = true;
    }

    private async Task LoadPostsAsync()
    {
        var posts = await PostsApiClient.GetPostsAsync();
        _posts.Clear();
        _posts.AddRange(posts);
    }

    private void OnImageSelected(InputFileChangeEventArgs args)
    {
        _selectedImage = args.File;
    }

    private void OnEditImageSelected(InputFileChangeEventArgs args)
    {
        _editSelectedImage = args.File;
    }

    private void StartEdit(PostResponse post)
    {
        _editingPostId = post.Id;
        _editSelectedImage = null;
        _editForm.Caption = post.Caption;
    }

    private void CancelEdit()
    {
        _editingPostId = null;
        _editSelectedImage = null;
        _editForm.Caption = string.Empty;
    }

    private async Task SaveEditAsync(PostResponse post)
    {
        _message = null;
        _isError = false;

        if (string.IsNullOrWhiteSpace(_editForm.Caption))
        {
            _isError = true;
            _message = "Caption is required.";
            return;
        }

        if (_editForm.Caption.Length > 280)
        {
            _isError = true;
            _message = "Caption must be at most 280 characters.";
            return;
        }

        _busyPostIds.Add(post.Id);

        try
        {
            var imageUrl = post.ImageUrl;

            if (_editSelectedImage is not null)
            {
                var uploadResult = await PostsApiClient.UploadImageAsync(_editSelectedImage);
                if (!uploadResult.Success || string.IsNullOrWhiteSpace(uploadResult.ImageUrl))
                {
                    _isError = true;
                    _message = uploadResult.Message;
                    return;
                }

                imageUrl = uploadResult.ImageUrl;
            }

            var updateResult = await PostsApiClient.UpdatePostAsync(post.Id, new UpdatePostRequest(_editForm.Caption.Trim(), imageUrl));
            _isError = !updateResult.Success;
            _message = updateResult.Message;

            if (updateResult.Success)
            {
                CancelEdit();
                await LoadPostsAsync();
            }
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _busyPostIds.Remove(post.Id);
        }
    }

    private async Task DeletePostAsync(PostResponse post)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Delete this post?");
        if (!confirmed)
        {
            return;
        }

        _message = null;
        _isError = false;
        _busyPostIds.Add(post.Id);

        try
        {
            var deleteResult = await PostsApiClient.DeletePostAsync(post.Id);
            _isError = !deleteResult.Success;
            _message = deleteResult.Message;

            if (deleteResult.Success)
            {
                if (_editingPostId == post.Id)
                {
                    CancelEdit();
                }

                await LoadPostsAsync();
            }
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _busyPostIds.Remove(post.Id);
        }
    }

    private async Task CreatePostAsync()
    {
        _message = null;
        _isError = false;

        if (_selectedImage is null)
        {
            _isError = true;
            _message = "Please select an image before creating the post.";
            return;
        }

        _submitting = true;

        try
        {
            var uploadResult = await PostsApiClient.UploadImageAsync(_selectedImage);
            if (!uploadResult.Success || string.IsNullOrWhiteSpace(uploadResult.ImageUrl))
            {
                _isError = true;
                _message = uploadResult.Message;
                return;
            }

            var createResult = await PostsApiClient.CreatePostAsync(new CreatePostRequest(_form.Platform, uploadResult.ImageUrl));

            _isError = !createResult.Success;
            _message = createResult.Message;

            if (createResult.Success)
            {
                _form.Platform = 0;
                _selectedImage = null;
                await LoadPostsAsync();
            }
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }

    private sealed class CreatePostForm
    {
        [Range(0, 1)]
        public int Platform { get; set; }
    }

    private sealed class EditPostForm
    {
        [Required]
        [MaxLength(280)]
        public string Caption { get; set; } = string.Empty;
    }
}
