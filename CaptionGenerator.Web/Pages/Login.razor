@page "/login"
@inject AuthApiClient AuthApiClient
@inject AuthStateStore AuthStateStore
@inject NavigationManager NavigationManager

<PageTitle>Login</PageTitle>

<div class="auth-page">
    <div class="auth-shell">
        <section class="auth-copy">
            <p class="auth-eyebrow">Welcome back</p>
            <h1 class="auth-title">Sign in to manage your caption workflow.</h1>
            <p class="auth-subtitle">Track drafts, schedule posts, and confirm publishing decisions from one clean dashboard.</p>

            <div class="auth-benefits">
                <div class="auth-benefit-item">
                    <span class="auth-benefit-icon">✓</span>
                    <div>
                        <strong>Fast access</strong>
                        <p>Jump straight back into your posts and publishing queue.</p>
                    </div>
                </div>
                <div class="auth-benefit-item">
                    <span class="auth-benefit-icon">⚡</span>
                    <div>
                        <strong>Simple workflow</strong>
                        <p>Keep your caption generation and post management in sync.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="surface-card auth-card">
            <div class="card-body auth-card-body">
                <div class="auth-card-header">
                    <p class="auth-card-kicker">Account access</p>
                    <h2 class="auth-card-title">Login</h2>
                    <p class="auth-card-text">Use your email and password to continue.</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <div class="alert @(_isError ? "alert-danger" : "alert-success")" role="alert">@_message</div>
                }

                <EditForm Model="_form" OnValidSubmit="OnSubmitAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <InputText class="form-control form-control-lg" @bind-Value="_form.Email" placeholder="name@example.com" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <InputText class="form-control form-control-lg" type="password" @bind-Value="_form.Password" placeholder="Enter your password" />
                    </div>

                    <button class="btn btn-primary btn-lg auth-submit" type="submit" disabled="@_submitting">@(_submitting ? "Signing in..." : "Login")</button>
                    <a class="btn btn-link auth-switch-link" href="/register">Need an account?</a>
                </EditForm>
            </div>
        </section>
    </div>
</div>

@code {
    private readonly LoginForm _form = new();
    private bool _submitting;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        await AuthStateStore.InitializeAsync();
        if (AuthStateStore.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/");
        }
    }

    private async Task OnSubmitAsync()
    {
        _submitting = true;
        _isError = false;
        _message = null;

        var result = await AuthApiClient.LoginAsync(new LoginRequest(_form.Email, _form.Password));
        _submitting = false;

        _message = result.Message;
        _isError = !result.Success;

        if (result.Success)
        {
            await AuthApiClient.ApplyAuthHeaderAsync();
            NavigationManager.NavigateTo("/");
        }
    }

    private class LoginForm
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        [MinLength(6)]
        public string Password { get; set; } = string.Empty;
    }
}
