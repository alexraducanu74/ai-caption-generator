# Docker Compose Environment Configuration

# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=caption_generator
DB_PORT=5433

# API Configuration
API_PORT=5000
JWT_KEY=this-is-a-dev-only-secret-key-change-me-12345
JWT_ISSUER=CaptionGenerator.API
JWT_AUDIENCE=CaptionGenerator.Web

# AI Service Configuration
AI_PORT=8000
MODEL_NAME=llava-hf/llava-1.5-7b-hf
CAPTION_MAX_LENGTH=280
CAPTION_SERVICE_URL=http://caption-service:8000

# Frontend Configuration
WEB_PORT=3000
API_BASE_URL=http://localhost:5000

# ASP.NET Environment
ASPNETCORE_ENVIRONMENT=Development

# Azure Configuration (uncomment for cloud deployment)
#AZURE_SUBSCRIPTION_ID=your-subscription-id
#AZURE_RESOURCE_GROUP=caption-generator-rg
#AZURE_LOCATION=eastus
#AZURE_CONTAINER_REGISTRY=yourregistryname
#AZURE_SQL_SERVER=your-sql-server-name
#AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;...
#AZURE_BLOB_CONTAINER=uploads
