{
  "ConnectionStrings": {
    "DefaultConnection": "Host=Your-Server.postgres.database.azure.com;Port=5432;Database=caption_generator;Username=pgadmin;Password=Your-Secure-Password;SslMode=Require;"
  },
  "Jwt": {
    "Issuer": "CaptionGenerator.API",
    "Audience": "CaptionGenerator.Web",
    "Key": "your-production-jwt-key-change-me-now-256-bit-minimum",
    "ExpiresMinutes": 60
  },
  "CaptionGeneration": {
    "BaseUrl": "https://caption-service-url-from-deployment",
    "GeneratePath": "/generate-caption"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureBlobStorage": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=your-account;AccountKey=your-key;EndpointSuffix=core.windows.net",
    "ContainerName": "uploads"
  }
}
